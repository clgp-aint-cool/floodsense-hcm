# Copy thành .env rồi điền giá trị. Không commit .env.

# Tài khoản tenant ThingsBoard cho backend (mặc định của LOAD_DEMO)
TB_TENANT_USER=tenant@thingsboard.org
TB_TENANT_PASSWORD=tenant

# Provisioning key/secret của Device Profile "flood-station" (tạo trong ThingsBoard UI)
TB_PROVISION_KEY=
TB_PROVISION_SECRET=

# Webhook Discord cho rule-chains/test_flood_discord_alert.py
DISCORD_WEBHOOK_URL=
